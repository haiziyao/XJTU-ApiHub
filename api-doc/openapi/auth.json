{
  "openapi": "3.1.0",
  "info": {
    "title": "XJTU-ApiHub 认证接口",
    "version": "0.2.0",
    "description": "注册前查询、注册、登录三个独立接口。测试接口与原接口使用相同的请求和业务响应，并附加 serve_raw 和 serve_data。"
  },
  "servers": [
    {
      "url": "https://api.xjtu-launcher.cn",
      "description": "生产"
    }
  ],
  "paths": {
    "/api/auth/register/lookup": {
      "post": {
        "operationId": "lookupRegistration",
        "summary": "注册前按完整学号查询昵称",
        "description": "进入社区页面前用本地学号查询是否已有昵称，用于决定是否允许输入昵称；不执行登录，也不验证校方身份。",
        "requestBody": {
          "$ref": "#/components/requestBodies/LookupNicknameRequest"
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupNicknameResponse"
                },
                "examples": {
                  "existing": {
                    "value": {
                      "code": 200,
                      "data": {
                        "nickname": "梧桐"
                      }
                    }
                  },
                  "new": {
                    "value": {
                      "code": 200,
                      "data": {
                        "nickname": null
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "学号缺失或格式无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "data": null
                }
              }
            }
          },
          "503": {
            "description": "查询服务暂时不可用，可稍后重试。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 503,
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "核验校园身份并注册社区账号",
        "description": "核验校方学籍凭证并创建社区账号。昵称可选，不传或为空时使用校方返回的真实姓名。注册成功不签发登录凭证，需要再调用登录接口。",
        "requestBody": {
          "$ref": "#/components/requestBodies/RegisterRequest"
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "studentNo": "0123456789",
                    "nickname": "梧桐"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求字段无效、未同意隐私协议，或无法确定昵称。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "校园凭证无效或已过期，需要重新取得凭证。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "校方返回的学号与请求不一致，或该学号已经注册。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 409,
                  "data": null
                }
              }
            }
          },
          "503": {
            "description": "暂时无法完成身份核验或访问账号服务，可稍后重试。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 503,
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "核验校园身份并登录社区账号",
        "description": "核验校方学籍凭证并签发社区登录凭证。账号必须已注册；未注册返回 404。",
        "requestBody": {
          "$ref": "#/components/requestBodies/LoginRequest"
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "accessToken": "<社区登录凭证>",
                    "studentNo": "0123456789",
                    "nickname": "梧桐"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求字段无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "校园凭证无效或已过期，需要重新取得凭证。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "该学号尚未注册，请先调用注册接口。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 404,
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "校方返回的学号与请求不一致。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 409,
                  "data": null
                }
              }
            }
          },
          "503": {
            "description": "暂时无法完成身份核验或访问账号服务，可稍后重试。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 503,
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api-test/auth/register/lookup": {
      "post": {
        "operationId": "lookupRegistrationTest",
        "summary": "注册前按完整学号查询昵称（联调）",
        "description": "复用原接口。此查询只读取昵称，serve_raw 和 serve_data 均为 null。",
        "requestBody": {
          "$ref": "#/components/requestBodies/LookupNicknameRequest"
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/LookupNicknameResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "data": {
                    "nickname": "梧桐"
                  },
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          },
          "400": {
            "description": "学号缺失或格式无效。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 400,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          },
          "503": {
            "description": "查询服务暂时不可用，可稍后重试。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 503,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          }
        }
      }
    },
    "/api-test/auth/register": {
      "post": {
        "operationId": "registerTest",
        "summary": "核验校园身份并注册社区账号（联调）",
        "description": "复用原接口。serve_raw 为校方响应，serve_data 为服务端写入的账号数据。",
        "requestBody": {
          "$ref": "#/components/requestBodies/RegisterRequest"
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/RegisterResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "data": {
                    "studentNo": "0123456789",
                    "nickname": "梧桐"
                  },
                  "serve_raw": {
                    "state": 200,
                    "data": {
                      "studentBean": {
                        "sno": "0123456789",
                        "name": "测试学生",
                        "className": "测试班级"
                      }
                    }
                  },
                  "serve_data": {
                    "studentNo": "0123456789",
                    "name": "测试学生",
                    "className": "测试班级",
                    "grade": "2024",
                    "nickname": "梧桐",
                    "gender": 1,
                    "provinceCode": "41",
                    "degreeType": 2,
                    "enrollmentYear": 2024
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求字段无效、未同意隐私协议，或无法确定昵称。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 400,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          },
          "401": {
            "description": "校园凭证无效或已过期，需要重新取得凭证。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 401,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          },
          "409": {
            "description": "校方返回的学号与请求不一致，或该学号已经注册。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 409,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          },
          "503": {
            "description": "暂时无法完成身份核验或访问账号服务，可稍后重试。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 503,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          }
        }
      }
    },
    "/api-test/auth/login": {
      "post": {
        "operationId": "loginTest",
        "summary": "核验校园身份并登录社区账号（联调）",
        "description": "复用原接口。serve_raw 为校方响应，serve_data 为服务端使用的账号数据。",
        "requestBody": {
          "$ref": "#/components/requestBodies/LoginRequest"
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/LoginResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "data": {
                    "accessToken": "<社区登录凭证>",
                    "studentNo": "0123456789",
                    "nickname": "梧桐"
                  },
                  "serve_raw": {
                    "state": 200,
                    "data": {
                      "studentBean": {
                        "sno": "0123456789",
                        "name": "测试学生",
                        "className": "测试班级"
                      }
                    }
                  },
                  "serve_data": {
                    "studentNo": "0123456789",
                    "nickname": "梧桐"
                  }
                }
              }
            }
          },
          "400": {
