    }
  },
  "components": {
    "schemas": {
      "StudentNo": {
        "type": "string",
        "pattern": "^\\S+$",
        "description": "完整学号，按字符串传输，保留前导零。"
      },
      "Nickname": {
        "type": "string",
        "pattern": "\\S",
        "description": "至少包含一个非空白字符，首次创建后固定。"
      },
      "ResponseEnvelope": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "与 HTTP 响应状态码一致。"
          },
          "data": {
            "description": "原接口的业务数据，失败时为 null。"
          }
        }
      },
      "ErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResponseEnvelope"
          },
          {
            "properties": {
              "code": {
                "minimum": 400,
                "maximum": 599
              },
              "data": {
                "type": "null"
              }
            }
          }
        ]
      },
      "TestFields": {
        "type": "object",
        "required": [
          "serve_raw",
          "serve_data"
        ],
        "properties": {
          "serve_raw": {
            "description": "服务端收到的上游响应正文。JSON 正文按 JSON 值返回，没有上游响应时为 null。"
          },
          "serve_data": {
            "type": [
              "object",
              "null"
            ],
            "description": "服务端拟保存的数据。该请求没有待保存数据时为 null。"
          }
        }
      },
      "LookupNicknameResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResponseEnvelope"
          },
          {
            "properties": {
              "code": {
                "const": 200
              },
              "data": {
                "type": "object",
                "required": [
                  "nickname"
                ],
                "properties": {
                  "nickname": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/Nickname"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "LoginResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResponseEnvelope"
          },
          {
            "properties": {
              "code": {
                "const": 200
              },
              "data": {
                "type": "object",
                "required": [
                  "accessToken",
                  "studentNo",
                  "nickname"
                ],
                "properties": {
                  "accessToken": {
                    "type": "string",
                    "minLength": 1,
                    "description": "ApiHub 签发的社区登录凭证。"
                  },
                  "studentNo": {
                    "$ref": "#/components/schemas/StudentNo"
                  },
                  "nickname": {
                    "$ref": "#/components/schemas/Nickname"
                  }
                }
              }
            }
          }
        ]
      },
      "RegisterResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResponseEnvelope"
          },
          {
            "properties": {
              "code": {
                "const": 200
              },
              "data": {
                "type": "object",
                "required": [
                  "studentNo",
                  "nickname"
                ],
                "properties": {
                  "studentNo": {
                    "$ref": "#/components/schemas/StudentNo"
                  },
                  "nickname": {
                    "$ref": "#/components/schemas/Nickname"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "requestBodies": {
      "LookupNicknameRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "studentNo"
              ],
              "properties": {
                "studentNo": {
                  "$ref": "#/components/schemas/StudentNo"
                }
              }
            },
            "example": {
              "studentNo": "0123456789"
            }
          }
        }
      },
      "RegisterRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "studentNo",
                "campusCredential",
                "privacyAccepted"
              ],
              "properties": {
                "studentNo": {
                  "$ref": "#/components/schemas/StudentNo"
                },
                "campusCredential": {
                  "type": "string",
                  "minLength": 1,
                  "writeOnly": true,
                  "description": "学籍档案（Hello）OAuth 登录取得的访问令牌。Launcher 对应字段为当前账号 sites[\"profile\"].token。"
                },
                "privacyAccepted": {
                  "type": "boolean",
                  "const": true,
                  "description": "用户已同意隐私协议。"
                },
                "nickname": {
                  "$ref": "#/components/schemas/Nickname",
                  "description": "可选。不传或为空时使用校方返回的真实姓名。"
                }
              }
            },
            "examples": {
              "withNickname": {
                "value": {
                  "studentNo": "0123456789",
                  "campusCredential": "<校园凭证>",
                  "privacyAccepted": true,
                  "nickname": "梧桐"
                }
              },
              "defaultRealName": {
                "value": {
                  "studentNo": "0123456789",
                  "campusCredential": "<校园凭证>",
                  "privacyAccepted": true
                }
              }
            }
          }
        }
      },
      "LoginRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "studentNo",
                "campusCredential"
              ],
              "properties": {
                "studentNo": {
                  "$ref": "#/components/schemas/StudentNo"
                },
                "campusCredential": {
                  "type": "string",
                  "minLength": 1,
                  "writeOnly": true,
                  "description": "学籍档案（Hello）OAuth 登录取得的访问令牌。Launcher 对应字段为当前账号 sites[\"profile\"].token。"
                }
              }
            },
            "example": {
              "studentNo": "0123456789",
              "campusCredential": "<校园凭证>"
            }
          }
        }
      }
    }
  }
}
