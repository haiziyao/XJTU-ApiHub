            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 400,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          },
          "401": {
            "description": "校园凭证无效或已过期，需要重新取得凭证。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 401,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          },
          "404": {
            "description": "该学号尚未注册，请先调用注册接口。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 404,
                  "data": null,
                  "serve_raw": null,
                  "serve_data": null
                }
              }
            }
          },
          "409": {
            "description": "校方返回的学号与请求不一致。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TestFields"
                    }
                  ]
                },
                "example": {
                  "code": 409,
